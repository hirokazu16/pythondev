     "text": [
      "10人のテストの平均点は73.4点です。\n"
     ]
    }
   ],
   "source": [
    "people = 0\n",
    "total_score =0\n",
    "\n",
    "while True:\n",
    "    score = input(\"点数を入力してください：\")\n",
    "    if score == \"-1\":\n",
    "        break\n",
    "    else:\n",
    "        people += 1\n",
    "        total_score += int(score)\n",
    "\n",
    "if people !=0:\n",
    "    print(str(people) + \"人のテストの平均点は\" + str(round(total_score / people, 1)) + \"点です。\")\n",
    "    "
   ]
  }
 ],
