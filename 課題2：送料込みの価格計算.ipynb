     "text": [
      "送料として350円かかります\n",
      "送料込みの価格は2330円です。\n"
     ]
    }
   ],
   "source": [
    "price = input(\"税抜価格を入力してください：\")\n",
    "# 軽減税率は考慮しない\n",
    "tax_rate = 0.1\n",
    "tax_includ_price = round(int(price) * (1 + tax_rate),0)\n",
    "if tax_includ_price >= 2000:\n",
    "    print(\"送料は無料です\")\n",
    "else:\n",
    "    print(\"送料として350円かかります\")\n",
    "    tax_includ_price += 350\n",
    "print(\"送料込みの価格は\" + str(int(tax_includ_price))+ \"円です。\")"
   ]
  }
 ],
